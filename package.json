{
  "name": "@victorodoyo/constraint-forge",
  "version": "1.0.0",
  "description": "Inspectable finite-domain constraint solving and puzzle generation",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": "./src/index.js",
  "bin": {
    "constraint-forge": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "bench": "node bench/run.js",
    "pack:check": "node scripts/pack-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "explore": "node scripts/explore.mjs",
    "bench:validate": "node bench/validate.js",
    "bench:report": "node bench/report.js",
    "examples": "node examples/workflows.mjs"
  },
  "files": [
    "src",
    "docs",
    "bench",
    "web",
    "scripts",
    "examples",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VictorOdoyo/constraint-forge.git"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
